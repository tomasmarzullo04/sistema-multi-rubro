# Copiar a packages/db/.env para desarrollo local.
# Coinciden con los defaults de docker-compose.yml en la raíz del repo.

# Runtime de la app: rol `app`, SIN BYPASSRLS (las políticas RLS aplican).
# El rol se crea en la migración 20260706_rls_probe (password solo para dev local).
DATABASE_URL="postgresql://app:app@localhost:5432/sistema_multi_rubro"

# Migraciones y CLI de Prisma: rol `postgres` (superusuario).
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_multi_rubro"
